# Copy to .env and edit the values you need.

DEPLOYMENT_MODE=docker

DOCKERHUB_REGISTRY=docker.1panel.live
TRUSTGUARD_IMAGE_PREFIX=trustguard-
TRUSTGUARD_SKILL_IMAGE_PREFIX=trustguard-skill-

# TRUSTGUARD_NETWORK_PROXY=http://localhost:7890

NPM_CONFIG_REGISTRY=https://registry.npmmirror.com/
UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
UV_EXTRA_INDEX_URL=
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_EXTRA_INDEX_URL=
DEBIAN_MIRROR_URL=https://mirrors.tuna.tsinghua.edu.cn/debian
DEBIAN_SECURITY_MIRROR_URL=https://mirrors.tuna.tsinghua.edu.cn/debian-security
GOPROXY=https://goproxy.cn
ALPINE_MIRROR_URL=https://mirrors.tuna.tsinghua.edu.cn/alpine
RUBYGEMS_MIRROR_URL=https://mirrors.tuna.tsinghua.edu.cn/rubygems/

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=trustguard_agent
MYSQL_USER=trustguard
MYSQL_PASSWORD=trustguard

LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL_ID=gpt-4o-mini

# Anthropic
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_MODEL_ID=claude-3-5-sonnet-latest
# ANTHROPIC_VERSION=2023-06-01

EXECUTION_DISPATCH_MODE=http
KB_ENABLED=false
# RAG MCP 完成替换后关闭旧静态知识读取；Experience 读取与沉淀仍由 KB_ENABLED 控制。
LEGACY_STATIC_KB_READ_ENABLED=true
LEGACY_EXPERIENCE_READ_ENABLED=true
MAX_IN_FLIGHT_SKILLS_PER_TASK=0

# Agent Orchestrator -> trustguard-rag MCP（Phase 3A 默认关闭）。
KNOWLEDGE_MCP_ENABLED=false
KNOWLEDGE_MCP_SHADOW_MODE=true
# Resource Read 并写入 Agent task-local Chunk Store；注入开启时会自动开启本地化。
KNOWLEDGE_MCP_MATERIALIZE_ENABLED=false
KNOWLEDGE_MCP_INJECT_ENABLED=false
KNOWLEDGE_MCP_MATERIALIZE_LIMIT=3
KNOWLEDGE_MCP_URL=http://host.docker.internal:18201/mcp
# 开发环境关闭 RAG MCP OAuth 时可留空；Phase 3A 由部署环境注入短期 JWT。
KNOWLEDGE_MCP_ACCESS_TOKEN=
KNOWLEDGE_MCP_SCOPE=penetration
KNOWLEDGE_MCP_MODE=comprehensive
KNOWLEDGE_MCP_LIMIT=5
KNOWLEDGE_MCP_REWRITE=false
KNOWLEDGE_MCP_TIMEOUT_SECONDS=8
KNOWLEDGE_MCP_MAX_RETRIES=1
KNOWLEDGE_MCP_WORKSPACE_ID=default
KNOWLEDGE_MCP_WORKFLOW_TYPE=penetration

# 独立 trustguard-rag 服务地址。Docker 内默认通过宿主机映射端口 18200 访问。
RAG_SERVICE_BASE_URL=http://host.docker.internal:18200
# Agent Gateway 调用 RAG 业务 REST 的服务身份，必须与 RAG_GATEWAY_SERVICE_TOKEN 一致。
RAG_GATEWAY_SERVICE_TOKEN=replace-with-a-different-long-random-service-token
# Agent 登录令牌签名密钥；生产环境必须替换为随机长密钥。
AUTH_TOKEN_SECRET=change-me-to-a-random-secret
AUTH_TOKEN_TTL_SECONDS=86400
# Agent Gateway 接受的单个知识文档最大字节数，默认 50 MiB。
RAG_UPLOAD_MAX_BYTES=52428800

# 单次点击“执行/续跑”的运行窗口，秒。到期会保存断点并 PAUSED；0 表示不限制。
ORCH_DEFAULT_RUN_MAX_DURATION_SECONDS=900

# ── Alert Triage (XDR / RAG MCP) ────────────────────────────────────
XDR_BASE_URL=http://host.docker.internal:8443
XDR_AK=test_ak_0001
XDR_SK=test_sk_0001_secret
XDR_TIMEOUT=30.0
XDR_MAX_RETRIES=2

# 告警研判复用上方 KNOWLEDGE_MCP_* 配置；部署环境应注入短期访问令牌。
